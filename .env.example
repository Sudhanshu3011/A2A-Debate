# Environment Settings
ENVIRONMENT=development
LOG_LEVEL=INFO

# LLM Providers Configuration
GROQ_API_KEY=your_groq_api_key_here

OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=https://github.com/myorg/debate-agent
OPENROUTER_APP_NAME=MultiAgent-Debate

# Application Defaults
DEFAULT_MAX_ROUNDS=3
REQUEST_TIMEOUT_SECONDS=30.0

# LangSmith Tracing & Observability (Standard Project Tracing)
LANGCHAIN_TRACING_V2=true
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=debate-a2a



# Agent Model Configurations (Environment-driven)
PROPONENT_MODEL=anthropic/claude-3.5-sonnet
OPPONENT_MODEL=llama-3.3-70b-versatile
JUDGE_MODEL=anthropic/claude-3.5-sonnet

